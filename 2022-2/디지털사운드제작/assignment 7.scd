/* 과제 7: 슈퍼콜라이더로 소리 만들기 및 설문


/* 의도 */
//// 목적: 지루하지 않고 경쾌한 알람을 만드는 것
//// 구현에 필요하겠다고 생각하는 슈퍼콜라이더 클래스 또는 구문.


/* 코드 및 주석 */
//// 구현:
(
SynthDef(\sinPerc, { |outbus, gate=1, attack=0.001, length, freq, amp, lag, pan|
	var env, source;
	env = Env.perc(attack, length - attack).kr(gate: gate, doneAction: Done.freeSelf);
	source = SinOsc.ar(freq.lag(lag)) * amp.lag(lag);
	source = source * env;
	source = Pan2.ar(source, pan);
	OffsetOut.ar(outbus, source)
}
).add
)



/* 설문 */
//// 다음 사항에 대한 의견 부탁드립니다:
////
//// - 타 과목과의 비교하여 본 과목에 실제로 투자하는 시간:
////   너무 많음[  ], 많음 [  ], 적당[  ], 적음[  ], 거의 없음[ o ]
////
//// - 적절하다고 생각하는 본 교과목에 매주 투자해야 할 시간:10시간
////
//// - 실제로 본 교과목에 매주 투자한 평균 시간:30분
////
//// - 이번 학기에 배운 정보량의 적절성: 너무 많음[ o ], 많음 [  ], 적당[  ], 적음[  ], 거의 없음[  ]
////   (참고: 다른 학기와 비교해 제가 같은 내용을 상당히 자주 반복하긴 했네요....)
////
//// - 전체 과제량: 너무 많음[ o ], 많음 [  ], 적당[  ], 적음[  ], 거의 없음[  ]
////
//// - 회당 과제량: 너무 많음[ o ], 많음 [  ], 적당[  ], 적음[  ], 거의 없음[  ]
////
//// - 과제의 전반적 난이도: 너무 높음[  ], 높음 [  ], 적당[ o ], 낮음[  ], 매우 낮음[  ],
////                         과제마다 다르나 전반적으로 적절[ o ],
////                         과제마다 다르나 전반적으로 부적절[  ]
////
//// - 개인 첨삭의 필요성: 절실[  ], 필요[  ], 보통[ o ], 불필요[  ]
////
//// - 적절하다고 생각하는 학기 중 개인 첨삭 총횟수:잘 모르겠음
////
//// - 적절하다고 생각하는 회당 첨삭 시간:잘 모르겠음
////
//// - 다음 중 배우지 않아도 된다고 생각하는 소프트웨어는?
////   Audacity[  ], Reaper[  ], SuperCollider[  ]
////
//// - 다음 중 유익하다고 생각되는 소프트웨어는?
////   Audacity[ o ], Reaper[ o ], SuperCollider[ o ]
////
//// - 소프트웨어를 배우는 순서는 어느 순서가 좋은가?
////   [ o ] 1. Audacity -> Reaper   -> SuperCollider
////   [  ] 2. Reaper   -> Audacity -> SuperCollider
////   [  ] 3. 주제에 따라 섞어서
////
//// - 대면 수업과 Zoom 수업 가운데 적절하다고 생각하는 것:필요에 따라 바뀔 수 있음
////
//// - 수업 시간에 배우는 양을 줄이고 첨삭을 수업 시간에 하는 것에 대한 의견을 자유롭게 기술:
////   첨삭을 수업 시간에 할 시 원하지 않은 사람들이 피해를 입을 수 있음
////
////
////
//// - 수업에 대한 전반적인 의견
////
////   제 개인 견해로는, 이 강좌를 많은 수강생이 원하는 강좌로 하려면,
////   리퍼를 중심으로 Audacity를 보조적으로 활용하며 SuperCollider는 다루지 않거나 더 줄여야 합니다.
////   하지만, 디지털 사운드 제작에 부합하려면 코딩을 어느 정도 해야 한다고 생각합니다.
////   여러분들은 어떻게 생각하시나요?
////   이 강의를 다시 하게 되면서 SuperCollider를 빼고 Reaper와 Audacity만 다룰까 고민이 많았는데,
////   여러분은 어떻게 생각하시는지 궁금합니다. 적지만, SuperCollider를 찾는 분들도 계시거든요.
////
